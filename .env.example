# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OpenAI
OPENAI_API_KEY=your_openai_key_here

# Xero OAuth
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here

# Must match exactly what you registered in the Xero Developer Portal
# For local dev with cloudflared/ngrok: https://your-tunnel-url/api/xero/callback
# For production: https://your-vercel-url.vercel.app/api/xero/callback
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback

# 32-byte hex key used to encrypt Xero tokens before storing in Supabase
# Generate your own with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes = 256 bits)
# Never commit this value — keep it secret
# In production, set this in Vercel environment variables
TOKEN_ENCRYPTION_KEY=your_64_char_hex_string_here

# Your app's public URL — used for redirects after Xero OAuth
# For local dev with cloudflared/ngrok: https://your-tunnel-url
# For production: https://your-vercel-url.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development