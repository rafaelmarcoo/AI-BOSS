# OpenAI
OPENAI_API_KEY=your_openai_key_here
# Main chat, scenario interpretation, tool calling, and generated UI planning.
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Lightweight cosmetic tasks such as AI-generated conversation titles.
OPENAI_UTILITY_MODEL=gpt-4o-mini-2024-07-18
OPENAI_DOCUMENT_MODEL=gpt-4o-mini-2024-07-18

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Environment
NODE_ENV=development

# Server-only multi-agent routing. Defaults to false when unset.
MULTI_AGENT_MODE=false

# Optional accounting connectors. A provider is shown as unavailable until
# all three server-side OAuth values for that provider are configured.
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REDIRECT_URI=http://localhost:3000/api/integrations/callback/zoho_books

FREEAGENT_CLIENT_ID=your_freeagent_client_id
FREEAGENT_CLIENT_SECRET=your_freeagent_client_secret
FREEAGENT_REDIRECT_URI=http://localhost:3000/api/integrations/callback/freeagent
FREEAGENT_ENV=sandbox
