# OpenAI
OPENAI_API_KEY=your_openai_key_here

# Anthropic (used for image document extraction — see lib/documents/image-extraction.ts)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Xero OAuth
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback

XERO_REDIRECT_URI=http://localhost:3000/api/integrations/callback/xero
XERO_WEBHOOK_KEY=your_xero_webhook_key_here
# Set true for demos without live Xero OAuth credentials.
XERO_DEMO_MODE=false

# QuickBooks (only if testing QuickBooks)
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret_here
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/callback/quickbooks
QUICKBOOKS_WEBHOOK_TOKEN= your_quickbooks_webhook_token_here

FRESHBOOKS_CLIENT_ID=your_freshbooks_client_id_here
FRESHBOOKS_CLIENT_SECRET=your_freshbooks_client_secret_here
FRESHBOOKS_REDIRECT_URI=http://localhost:3000/api/integrations/callback/freshbooks

# 32-byte hex key used to encrypt Xero tokens before storing them.
# Generate one with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your_64_character_hex_key_here

# Public app URL used for OAuth redirects after Xero returns to the app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development
QUICKBOOKS_ENV=sandbox

# Server-only multi-agent routing. Defaults to false when unset.
MULTI_AGENT_MODE=false
